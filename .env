PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=hrbot
PGUSER=postgres
PGPASSWORD=


# --- OpenAI (turns on translations/flowcharts/polish/rule-extraction) ---
OPENAI_API_KEY
OPENAI_MODEL=gpt-4o       # optional (default is gpt-4o-mini)



# --- Admin/Plugin (optional, but useful) ---
ADMIN_API_KEY=supersecret
RAG_PLUGIN_API_KEY=pluginsecret

# --- Copilot / Bot Framework (disabled) ---
COPILOT_ENABLED=0
DIRECT_LINE_SECRET=
DIRECT_LINE_BASE=https://europe.directline.botframework.com

# --- CSP / Fusion (optional) ---
CSP_FRAME_ANCESTORS=''

# --- TLS (optional; if you have certs) ---
# TLS_KEY_FILE=../certs/hr-bot.local-key.pem
# TLS_CERT_FILE=../certs/hr-bot.local.pem
